# 复制成 .env 后填自己的值（.env 不进 git）
PORT=3000
# 不持久化：内存 SQLite；想落盘改成 sqlite:demo.db
DATABASE_URL=sqlite::memory:?cache=shared
# 日志级别
RUST_LOG=rust_otel_starter=debug

# ---- OTLP 上报后端（三选一，留空 = 不上报，只看本地日志）----
# 1) Grafana Cloud 免费版（推荐，永久免费：50GB traces/月，14 天保留）
#    地址在 Grafana Cloud 控制台 Send data > OpenTelemetry 里找，
#    用户名是实例 ID，密码是 API token
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-0.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(实例ID:API token)>
# 2) SigNoz Cloud（30 天试用，之后 Teams $49/月起）
# OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.us.signoz.cloud:443
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<你的 ingestion key>
# 3) 本地 OTEL Collector / 自建 SigNoz
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# 协议：http/protobuf（默认）或 http/json
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
